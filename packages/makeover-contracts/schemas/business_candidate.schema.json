{
  "$comment": "makeover-contracts 0.1.0",
  "$defs": {
    "BusinessCategory": {
      "description": "Coarse category, chosen to map onto render templates rather than to\nmirror the full OpenStreetMap tag vocabulary.",
      "enum": [
        "restaurant",
        "cafe",
        "bakery",
        "bar",
        "retail",
        "salon",
        "clinic",
        "hotel",
        "workshop",
        "other"
      ],
      "title": "BusinessCategory",
      "type": "string"
    },
    "DataLicense": {
      "description": "The terms the data arrived under.\n\nThis drives both the attribution rendered on the landing page and the\nretention sweeper, so it is a closed set rather than a free-text field.",
      "enum": [
        "odbl-1.0",
        "google-places-tos",
        "publicly-published",
        "user-provided",
        "not-applicable"
      ],
      "title": "DataLicense",
      "type": "string"
    },
    "DataSource": {
      "description": "Where a field originally came from.",
      "enum": [
        "openstreetmap",
        "google_places",
        "business_website",
        "manual_upload",
        "derived"
      ],
      "title": "DataSource",
      "type": "string"
    },
    "GeoPoint": {
      "additionalProperties": false,
      "description": "A WGS-84 coordinate.",
      "properties": {
        "lat": {
          "maximum": 90.0,
          "minimum": -90.0,
          "title": "Lat",
          "type": "number"
        },
        "lon": {
          "maximum": 180.0,
          "minimum": -180.0,
          "title": "Lon",
          "type": "number"
        }
      },
      "required": [
        "lat",
        "lon"
      ],
      "title": "GeoPoint",
      "type": "object"
    },
    "SourceRef": {
      "additionalProperties": false,
      "description": "Where a value came from, when, and under what terms.",
      "properties": {
        "fetched_at": {
          "description": "Timezone-aware UTC instant of retrieval",
          "format": "date-time",
          "title": "Fetched At",
          "type": "string"
        },
        "license": {
          "$ref": "#/$defs/DataLicense"
        },
        "retention_until": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Instant after which this value must be purged. None means no limit.",
          "title": "Retention Until"
        },
        "source": {
          "$ref": "#/$defs/DataSource"
        },
        "source_id": {
          "anyOf": [
            {
              "maxLength": 256,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Source Id"
        },
        "url": {
          "anyOf": [
            {
              "maxLength": 2048,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Url"
        }
      },
      "required": [
        "source",
        "license",
        "fetched_at"
      ],
      "title": "SourceRef",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "description": "A search hit, before any enrichment.\n\nCarries a single ``SourceRef`` because every field came from the same\ndirectory response in one call.",
  "properties": {
    "address_line": {
      "anyOf": [
        {
          "maxLength": 300,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Address Line"
    },
    "category": {
      "$ref": "#/$defs/BusinessCategory"
    },
    "external_id": {
      "maxLength": 128,
      "minLength": 1,
      "title": "External Id",
      "type": "string"
    },
    "location": {
      "$ref": "#/$defs/GeoPoint"
    },
    "name": {
      "maxLength": 200,
      "minLength": 1,
      "title": "Name",
      "type": "string"
    },
    "source": {
      "$ref": "#/$defs/SourceRef"
    },
    "website": {
      "anyOf": [
        {
          "maxLength": 2048,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Website"
    }
  },
  "required": [
    "external_id",
    "name",
    "category",
    "location",
    "source"
  ],
  "title": "BusinessCandidate",
  "type": "object"
}
