# Copy to .env for local development. Never commit .env.
MAKEOVER_ENVIRONMENT=local
MAKEOVER_LOG_LEVEL=INFO

# Identifies this crawler to Nominatim and Overpass, whose usage policies
# require a contactable User-Agent. Set before enabling Phase 1 adapters.
MAKEOVER_USER_AGENT="makeover-discovery/0.1 (you@example.com)"

# Repo B's job API. Also required to run the Phase 6 pipeline command, since
# there is nothing to submit a SceneSpec to without it.
# MAKEOVER_RENDER_SERVICE_URL=http://localhost:8081

# Phase 2, optional. Leaving this unset keeps the pipeline on OSM only.
# MAKEOVER_GOOGLE_PLACES_API_KEY=

# Phase 3. Required to generate design briefs, and in production.
# MAKEOVER_ANTHROPIC_API_KEY=
# MAKEOVER_ANTHROPIC_MODEL=claude-opus-5
# MAKEOVER_ANTHROPIC_EFFORT=high

# Phase 6, optional. How long and how often to poll a submitted render job.
# MAKEOVER_RENDER_POLL_INTERVAL_S=3.0
# MAKEOVER_RENDER_POLL_TIMEOUT_S=300.0
